#!/usr/bin/env bash
#
#  benchmark — Every performance target in one run.
#
#  Usage:
#    ./benchmark              Scan (100K), render, launch
#    ./benchmark --full       Also the 1M-file scan (~2 min to build the tree)
#    ./benchmark --markdown   Emit a Markdown table, for README.md
#
#  The README quotes these numbers. Regenerating them here is what keeps the
#  README from drifting into claims nobody has checked lately.
#
#  Targets come from documents/1_PROJECT_GUIDE.md §1.3.
#

set -uo pipefail
# Not `set -e`: every number below is extracted with grep, and grep exits
# non-zero when a pattern is absent. Under -e a single missing measurement
# would kill the run instead of reporting "?" for that row.

export PATH="$HOME/.cargo/bin:$PATH"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

FULL=false
MARKDOWN=false
for arg in "${@:-}"; do
    case "$arg" in
        --full)     FULL=true ;;
        --markdown) MARKDOWN=true ;;
        --help|-h)  sed -n '/^#  /,/^#$/p' "$0" | sed 's/^# //; s/^#$//'; exit 0 ;;
        "") ;;
        *) echo "Unknown argument: $arg" >&2; exit 1 ;;
    esac
done

BOLD='\033[1m'; GREEN='\033[32m'; BLUE='\033[34m'; RESET='\033[0m'
say() { $MARKDOWN || echo -e "$@"; }

say "${BOLD}Disk Tracker — benchmark${RESET}"
say "$(sw_vers -productName) $(sw_vers -productVersion) · $(sysctl -n machdep.cpu.brand_string)"
say

# ── Scan engine ──────────────────────────────────────────────────────
say "${BLUE}Scan engine (Rust, release)${RESET}"
cd "$ROOT/traversal-engine"

SCALE_ENV=""
$FULL && SCALE_ENV="1m"
SCAN_OUT="$(DISK_TRACKER_SCALE="$SCALE_ENV" cargo test --release --test scale_tests -- --nocapture 2>&1 || true)"

scan_100k="$(set +e; grep -A2 '^100K files' <<<"$SCAN_OUT" | grep -oE '[0-9]+\.[0-9]+ s' | head -1 | tr -d ' s')"
mem_100k="$(set +e; grep -A3 '^100K files' <<<"$SCAN_OUT" | grep -oE '[0-9]+\.[0-9]+ MB' | head -1 | tr -d ' MB')"
scan_1m="$(set +e; grep -A2 '^1M files' <<<"$SCAN_OUT" | grep -oE '[0-9]+\.[0-9]+ s' | head -1 | tr -d ' s')"
mem_1m="$(set +e; grep -A3 '^1M files' <<<"$SCAN_OUT" | grep -oE '[0-9]+\.[0-9]+ MB' | head -1 | tr -d ' MB')"

say "  100K files   ${scan_100k:-?} s   ${mem_100k:-?} MB"
$FULL && say "  1M files     ${scan_1m:-?} s   ${mem_1m:-?} MB"
say

# ── Canvas layout ────────────────────────────────────────────────────
#
# Release, not Debug. The test target builds -Onone by default, where this kind
# of tight numeric loop runs an order of magnitude slower — Debug figures say
# nothing about what ships. Testability is required for @testable; it costs some
# cross-module specialization but leaves -O in place within the module.
say "${BLUE}Canvas layout (Release, 50K children)${RESET}"
cd "$ROOT"
RENDER_OUT="$(xcodebuild test \
    -project DiskTracker/DiskTracker.xcodeproj -scheme DiskTracker \
    -configuration Release -destination 'platform=macOS' \
    ENABLE_TESTABILITY=YES CODE_SIGNING_ALLOWED=NO \
    -only-testing:DiskTrackerTests/RenderBudgetTests 2>&1 || true)"

treemap_ms="$(set +e; grep -oE 'treemap layout, 50k children: [0-9]+\.[0-9]+' <<<"$RENDER_OUT" | grep -oE '[0-9]+\.[0-9]+' | head -1)"
sunburst_ms="$(set +e; grep -oE 'sunburst layout, 50k children: [0-9]+\.[0-9]+' <<<"$RENDER_OUT" | grep -oE '[0-9]+\.[0-9]+' | head -1)"
hit_ms="$(set +e; grep -oE 'sunburst hit test: [0-9]+\.[0-9]+' <<<"$RENDER_OUT" | grep -oE '[0-9]+\.[0-9]+' | head -1)"

say "  treemap      ${treemap_ms:-?} ms per frame"
say "  sunburst     ${sunburst_ms:-?} ms per frame"
say "  hit test     ${hit_ms:-?} ms per probe"
say "  frame budget 16.67 ms at 60 fps"
say

# ── Launch ───────────────────────────────────────────────────────────
say "${BLUE}Cold launch (Release)${RESET}"
if [[ -d "$ROOT/.build-release/Build/Products/Release/DiskTracker.app" ]]; then
    LAUNCH_OUT="$("$ROOT/measure-launch" 5 2>&1 || true)"
    launch_median="$(set +e; grep -oE 'LAUNCH_MEDIAN_SECONDS=[0-9.]+' <<<"$LAUNCH_OUT" | cut -d= -f2)"
    say "  first frame  ${launch_median:-?} s (median of 5)"
else
    say "  skipped — run ./package-release --verify first"
fi
say

# ── Markdown ─────────────────────────────────────────────────────────
if $MARKDOWN; then
    cat <<MD
| Measurement | Target | Result |
|---|---|---|
| Scan 100K files | ≤ 3 s | **${scan_100k:-?} s** |
| Scan 1M files | ≤ 15 s | **${scan_1m:-not run} s** |
| Memory, 100K files | — | ${mem_100k:-?} MB |
| Memory, 1M files | ≤ 300 MB | **${mem_1m:-not run} MB** |
| Treemap layout, 50K children | ≤ 16.67 ms | **${treemap_ms:-?} ms** |
| Sunburst layout, 50K children | ≤ 16.67 ms | **${sunburst_ms:-?} ms** |
| Cold launch to first frame | ≤ 2 s | **${launch_median:-?} s** |

<sub>$(sysctl -n machdep.cpu.brand_string), $(sw_vers -productName) $(sw_vers -productVersion). Regenerate with \`./benchmark --full --markdown\`.</sub>
MD
else
    echo -e "${GREEN}Done.${RESET} Add --markdown for a README table, --full for the 1M case."
fi

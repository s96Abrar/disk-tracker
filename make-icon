#!/usr/bin/env swift
//
//  make-icon — Write the Disk Tracker app icon as an Icon Composer document
//
//  Usage:
//    ./make-icon
//
//  The icon is drawn, not painted: the brand indigo with a treemap of blocks
//  on it, which is what the app actually shows you. It is an Icon Composer
//  `.icon` (macOS 26 Liquid Glass): a gradient fill plus two layer groups. The
//  system supplies the squircle, glass, specular highlights and shadow, and
//  derives the dark, clear and tinted appearances. Xcode also compiles it into
//  a classic AppIcon.icns for macOS 15.
//
//  Output:
//    DiskTracker/Sources/AppIcon.icon/   icon.json + Assets/*.svg
//    docs/icon.png                        256px preview for the README
//  Sources/ is a synchronized group, so Xcode picks the icon up with no project
//  file edit. The preview needs ictool, which ships inside Xcode's Icon Composer.
//

import CoreGraphics
import Foundation

// ── Design ───────────────────────────────────────────────────────────
// All measurements are fractions of the icon shape: the system masks the
// canvas to the squircle, so the canvas edge is the shape edge.

let canvas = 1024.0
let blockInset = 0.174     // treemap padding inside the shape
let blockGap = 0.0274      // gutter between blocks
let blockRadius = 0.0224

typealias RGBA = (r: Double, g: Double, b: Double, a: Double)

let gradientTop: RGBA = (0.482, 0.475, 0.961, 1)     // #7B79F5
let gradientBottom: RGBA = (0.247, 0.239, 0.722, 1)  // #3F3DB8

/// x, y, width, height in the treemap's unit square (y grows downward),
/// then the block's fill. One squarified split, the same shape the
/// treemap view produces for a real folder.
let tiles: [(CGRect, RGBA)] = [
    (CGRect(x: 0.00, y: 0.00, width: 0.56, height: 0.60), (1, 1, 1, 0.97)),
    (CGRect(x: 0.56, y: 0.00, width: 0.44, height: 0.34), (1, 1, 1, 0.70)),
    (CGRect(x: 0.56, y: 0.34, width: 0.44, height: 0.26), (1, 1, 1, 0.46)),
    (CGRect(x: 0.00, y: 0.60, width: 0.34, height: 0.40), (1, 1, 1, 0.58)),
    (CGRect(x: 0.64, y: 0.60, width: 0.36, height: 0.40), (1, 1, 1, 0.36)),
]
/// The one block that is not white: reclaimable space, in the same green the
/// app uses for a healthy volume (#42E355). Its own group, so it sits above
/// the others in the glass stack.
let reclaim: (CGRect, RGBA) =
    (CGRect(x: 0.34, y: 0.60, width: 0.30, height: 0.40), (0.259, 0.890, 0.333, 1))

// ── SVG layers ───────────────────────────────────────────────────────

func svg(_ blocks: [(CGRect, RGBA)]) -> String {
    let field = canvas * (1 - 2 * blockInset)
    let origin = canvas * blockInset
    let gap = canvas * blockGap
    let radius = canvas * blockRadius
    let rects = blocks.map { unit, c in
        let hex = String(format: "#%02X%02X%02X",
                         Int((c.r * 255).rounded()), Int((c.g * 255).rounded()), Int((c.b * 255).rounded()))
        return String(format: #"<rect x="%.1f" y="%.1f" width="%.1f" height="%.1f" rx="%.1f" fill="%@" fill-opacity="%.2f"/>"#,
                      origin + unit.minX * field + gap / 2, origin + unit.minY * field + gap / 2,
                      unit.width * field - gap, unit.height * field - gap, radius, hex, c.a)
    }
    return #"<svg xmlns="http://www.w3.org/2000/svg" width="1024" height="1024" viewBox="0 0 1024 1024">"#
        + rects.joined() + "</svg>\n"
}

func color(_ c: RGBA) -> String {
    String(format: "srgb:%.5f,%.5f,%.5f,%.5f", c.r, c.g, c.b, c.a)
}

func group(_ image: String) -> [String: Any] {
    [
        "layers": [["image-name": "\(image).svg", "name": image, "glass": true]],
        "shadow": ["kind": "neutral", "opacity": 0.5],
        "translucency": ["enabled": true, "value": NSDecimalNumber(string: "0.3")] as [String: Any],
    ]
}

// Top-left to bottom-right, the same direction as the old drawn gradient.
// Groups are listed front to back.
let document: [String: Any] = [
    "fill": [
        "linear-gradient": [color(gradientTop), color(gradientBottom)],
        "orientation": ["start": ["x": 0, "y": 0], "stop": ["x": 1, "y": 1]],
    ],
    "groups": [group("reclaim"), group("tiles")],
    "supported-platforms": ["squares": ["macOS"]],
]

// ── Write ────────────────────────────────────────────────────────────

let root = URL(fileURLWithPath: CommandLine.arguments[0])
    .resolvingSymlinksInPath()
    .deletingLastPathComponent()
let iconDir = root.appendingPathComponent("DiskTracker/Sources/AppIcon.icon")
let assets = iconDir.appendingPathComponent("Assets")

try? FileManager.default.removeItem(at: iconDir)
try FileManager.default.createDirectory(at: assets, withIntermediateDirectories: true)
try svg(tiles).write(to: assets.appendingPathComponent("tiles.svg"), atomically: true, encoding: .utf8)
try svg([reclaim]).write(to: assets.appendingPathComponent("reclaim.svg"), atomically: true, encoding: .utf8)
try JSONSerialization.data(withJSONObject: document, options: [.prettyPrinted, .sortedKeys])
    .write(to: iconDir.appendingPathComponent("icon.json"))
print("Wrote \(iconDir.path)")

// ── README preview ───────────────────────────────────────────────────

let ictool = "/Applications/Xcode.app/Contents/Applications/Icon Composer.app/Contents/Executables/ictool"
let preview = root.appendingPathComponent("docs/icon.png")
let render = Process()
render.executableURL = URL(fileURLWithPath: ictool)
render.arguments = [iconDir.path, "--export-image", "--output-file", preview.path,
                    "--platform", "macOS", "--rendition", "Default",
                    "--width", "256", "--height", "256", "--scale", "1"]
render.standardOutput = FileHandle.nullDevice
do {
    try render.run()
    render.waitUntilExit()
} catch {
    FileHandle.standardError.write("ictool not found — preview skipped (\(error.localizedDescription))\n".data(using: .utf8)!)
    exit(1)
}
guard render.terminationStatus == 0 else {
    FileHandle.standardError.write("ictool failed to render the preview\n".data(using: .utf8)!)
    exit(1)
}
print("Wrote \(preview.path)")

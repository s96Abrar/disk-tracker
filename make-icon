#!/usr/bin/env swift
//
//  make-icon — Render the Disk Tracker app icon into the asset catalog
//
//  Usage:
//    ./make-icon
//
//  The icon is drawn, not painted: a squircle in the brand indigo with a
//  treemap of blocks on it, which is what the app actually shows you. Every
//  size is rendered from the same vector code rather than downsampled from
//  1024, so the 16pt one stays crisp.
//
//  Output: DiskTracker/Sources/Assets.xcassets/AppIcon.appiconset/
//  Sources/ is a synchronized group, so Xcode picks the catalog up with no
//  project file edit.
//

import CoreGraphics
import Foundation
import ImageIO
import UniformTypeIdentifiers

// ── Design ───────────────────────────────────────────────────────────
// All measurements are fractions of the canvas, so one draw call serves
// every size.

/// The macOS icon grid leaves the outer ~10% empty; a full-bleed square
/// looks oversized next to every other icon in the Dock.
let shapeInset = 0.098
/// Superellipse exponent. 5 is close to the system's continuous corner;
/// a plain rounded rect reads subtly wrong at 512pt and up.
let squircleN = 5.0
let blockInset = 0.14      // treemap padding inside the squircle
let blockGap = 0.022       // gutter between blocks, in canvas fractions
let blockRadius = 0.018

typealias RGBA = (r: Double, g: Double, b: Double, a: Double)

let gradientTop: RGBA = (0.482, 0.475, 0.961, 1)     // #7B79F5
let gradientBottom: RGBA = (0.247, 0.239, 0.722, 1)  // #3F3DB8

/// x, y, width, height in the treemap's unit square (y grows downward),
/// then the block's fill. One squarified split, the same shape the
/// treemap view produces for a real folder.
let blocks: [(CGRect, RGBA)] = [
    (CGRect(x: 0.00, y: 0.00, width: 0.56, height: 0.60), (1, 1, 1, 0.97)),
    (CGRect(x: 0.56, y: 0.00, width: 0.44, height: 0.34), (1, 1, 1, 0.70)),
    (CGRect(x: 0.56, y: 0.34, width: 0.44, height: 0.26), (1, 1, 1, 0.46)),
    (CGRect(x: 0.00, y: 0.60, width: 0.34, height: 0.40), (1, 1, 1, 0.58)),
    // The one block that is not white: reclaimable space, in the same
    // green the app uses for a healthy volume (#42E355).
    (CGRect(x: 0.34, y: 0.60, width: 0.30, height: 0.40), (0.259, 0.890, 0.333, 0.95)),
    (CGRect(x: 0.64, y: 0.60, width: 0.36, height: 0.40), (1, 1, 1, 0.36)),
]

// ── Drawing ──────────────────────────────────────────────────────────

/// Superellipse centred in `rect`. |x/a|^n + |y/b|^n = 1.
func squirclePath(in rect: CGRect, n: Double) -> CGPath {
    let path = CGMutablePath()
    let (a, b) = (rect.width / 2, rect.height / 2)
    let (cx, cy) = (rect.midX, rect.midY)
    let steps = 720
    for i in 0...steps {
        let t = 2 * Double.pi * Double(i) / Double(steps)
        let (c, s) = (cos(t), sin(t))
        let x = cx + a * copysign(pow(abs(c), 2 / n), c)
        let y = cy + b * copysign(pow(abs(s), 2 / n), s)
        i == 0 ? path.move(to: CGPoint(x: x, y: y)) : path.addLine(to: CGPoint(x: x, y: y))
    }
    path.closeSubpath()
    return path
}

func color(_ c: RGBA) -> CGColor {
    CGColor(srgbRed: c.r, green: c.g, blue: c.b, alpha: c.a)
}

func drawIcon(size: Int) -> CGImage? {
    let s = CGFloat(size)
    guard let ctx = CGContext(
        data: nil, width: size, height: size, bitsPerComponent: 8, bytesPerRow: 0,
        space: CGColorSpace(name: CGColorSpace.sRGB)!,
        bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue
    ) else { return nil }

    ctx.setAllowsAntialiasing(true)
    ctx.interpolationQuality = .high

    let inset = s * CGFloat(shapeInset)
    let shape = CGRect(x: inset, y: inset, width: s - inset * 2, height: s - inset * 2)
    let path = squirclePath(in: shape, n: squircleN)

    // Ambient shadow. Skipped below 64pt, where it is one grey pixel of mud.
    if size >= 64 {
        ctx.saveGState()
        ctx.setShadow(offset: CGSize(width: 0, height: -s * 0.012),
                      blur: s * 0.022,
                      color: CGColor(srgbRed: 0, green: 0, blue: 0, alpha: 0.28))
        ctx.setFillColor(color(gradientBottom))
        ctx.addPath(path)
        ctx.fillPath()
        ctx.restoreGState()
    }

    ctx.saveGState()
    ctx.addPath(path)
    ctx.clip()

    let gradient = CGGradient(
        colorsSpace: CGColorSpace(name: CGColorSpace.sRGB)!,
        colors: [color(gradientTop), color(gradientBottom)] as CFArray,
        locations: [0, 1]
    )!
    // Top-left to bottom-right; CoreGraphics' origin is bottom-left.
    ctx.drawLinearGradient(gradient,
                           start: CGPoint(x: shape.minX, y: shape.maxY),
                           end: CGPoint(x: shape.maxX, y: shape.minY),
                           options: [])

    // Treemap.
    let field = shape.insetBy(dx: s * CGFloat(blockInset), dy: s * CGFloat(blockInset))
    let gap = s * CGFloat(blockGap)
    let radius = max(s * CGFloat(blockRadius), 0.5)
    for (unit, fill) in blocks {
        let rect = CGRect(
            x: field.minX + unit.minX * field.width + gap / 2,
            // Flip: block coordinates read top-down, the context is bottom-up.
            y: field.minY + (1 - unit.maxY) * field.height + gap / 2,
            width: unit.width * field.width - gap,
            height: unit.height * field.height - gap
        )
        ctx.setFillColor(color(fill))
        ctx.addPath(CGPath(roundedRect: rect, cornerWidth: radius, cornerHeight: radius, transform: nil))
        ctx.fillPath()
    }

    ctx.restoreGState()
    return ctx.makeImage()
}

// ── Catalog ──────────────────────────────────────────────────────────

/// (point size, scale) — the ten images a macOS app icon set requires.
let variants: [(Int, Int)] = [
    (16, 1), (16, 2), (32, 1), (32, 2), (128, 1),
    (128, 2), (256, 1), (256, 2), (512, 1), (512, 2),
]

let root = URL(fileURLWithPath: CommandLine.arguments[0])
    .resolvingSymlinksInPath()
    .deletingLastPathComponent()
let outDir = root
    .appendingPathComponent("DiskTracker/Sources/Assets.xcassets/AppIcon.appiconset")

try FileManager.default.createDirectory(at: outDir, withIntermediateDirectories: true)

var images: [[String: String]] = []
for (points, scale) in variants {
    let pixels = points * scale
    let name = "icon_\(points)x\(points)\(scale == 2 ? "@2x" : "").png"
    guard let image = drawIcon(size: pixels) else {
        FileHandle.standardError.write("failed to render \(name)\n".data(using: .utf8)!)
        exit(1)
    }
    let url = outDir.appendingPathComponent(name)
    guard let dest = CGImageDestinationCreateWithURL(url as CFURL, UTType.png.identifier as CFString, 1, nil) else {
        FileHandle.standardError.write("cannot write \(url.path)\n".data(using: .utf8)!)
        exit(1)
    }
    CGImageDestinationAddImage(dest, image, nil)
    guard CGImageDestinationFinalize(dest) else {
        FileHandle.standardError.write("cannot finalize \(url.path)\n".data(using: .utf8)!)
        exit(1)
    }
    images.append([
        "filename": name,
        "idiom": "mac",
        "scale": "\(scale)x",
        "size": "\(points)x\(points)",
    ])
    print("  \(name)  \(pixels)x\(pixels)")
}

let contents: [String: Any] = [
    "images": images,
    "info": ["author": "xcode", "version": 1],
]
let json = try JSONSerialization.data(withJSONObject: contents, options: [.prettyPrinted, .sortedKeys])
try json.write(to: outDir.appendingPathComponent("Contents.json"))

// An asset catalog needs a root Contents.json or Xcode ignores the folder.
let catalogRoot = outDir.deletingLastPathComponent()
let rootContents = try JSONSerialization.data(
    withJSONObject: ["info": ["author": "xcode", "version": 1]],
    options: [.prettyPrinted, .sortedKeys]
)
try rootContents.write(to: catalogRoot.appendingPathComponent("Contents.json"))

print("\nWrote \(variants.count) images to \(outDir.path)")

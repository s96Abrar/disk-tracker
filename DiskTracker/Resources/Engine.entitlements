<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The scan engine. The App Store requires every executable in a sandboxed
         app to be sandboxed itself; with inherit it runs in the app's sandbox,
         including folder grants, instead of getting its own container. A
         process with inherit must carry exactly these two keys. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>
